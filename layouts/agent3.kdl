// maxagent 3 - one tall pane on the left, right column split top/bottom.
layout {
    pane_template name="agent" {
        command "bash"
        args "-lc" "exec $HOME/.local/bin/maxagent-pane"
    }
    tab name="agent" focus=true {
        pane split_direction="vertical" {
            agent
            pane split_direction="horizontal" {
                agent
                agent
            }
        }
    }
}
