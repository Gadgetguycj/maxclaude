// maxagent 2 - two persistent agent panes, side by side.
layout {
    pane_template name="agent" {
        command "bash"
        args "-lc" "exec $HOME/.local/bin/maxagent-pane"
    }
    tab name="agent" focus=true {
        pane split_direction="vertical" {
            agent
            agent
        }
    }
}
