// maxagent 1 — single persistent agent pane.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    pane_template name="agent" {
        command "bash"
        args "-lc" "exec $HOME/.local/bin/maxagent-pane"
    }
    tab name="agent" focus=true {
        agent
    }
}
