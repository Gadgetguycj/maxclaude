// maxagent 4 - four persistent agent panes in a 2x2 grid.
layout {
    pane_template name="agent" {
        command "bash"
        args "-lc" "exec $HOME/.local/bin/maxagent-pane"
    }
    tab name="agent" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                agent
                agent
            }
            pane split_direction="vertical" {
                agent
                agent
            }
        }
    }
}
