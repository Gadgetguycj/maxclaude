#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$DIR/maxagent" ]; then
  echo "maxclaude: maxagent not found at $DIR/maxagent. Re-run the installer (install.sh)." >&2
  exit 127
fi
export MAXAGENT_DEFAULT_PROVIDER=claude
export MAXAGENT_SESSION_PREFIX=legacy
export MAXAGENT_APP=maxclaude
exec "$DIR/maxagent" "$@"
