#!/usr/bin/env bash
# Runs inside each zellij pane. Selects the agent profile from session metadata.
set -euo pipefail

CONFIG_ROOT="${MAXAGENT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/maxagent}"
SESSION="${ZELLIJ_SESSION_NAME:-}"
META="$CONFIG_ROOT/sessions/${SESSION}.env"
PROVIDER="${MAXAGENT_PROVIDER:-codex}"

if [ -r "$META" ]; then
  # shellcheck disable=SC1090
  . "$META"
  PROVIDER="${MAXAGENT_PROVIDER:-$PROVIDER}"
fi

PROFILE="$CONFIG_ROOT/profiles/${PROVIDER}.sh"
if [ ! -r "$PROFILE" ]; then
  echo "maxagent-pane: missing profile: $PROFILE" >&2
  exit 127
fi

# Profiles are installed/generated by install.sh and are expected to exec.
# shellcheck disable=SC1090
. "$PROFILE"

echo "maxagent-pane: profile did not exec: $PROFILE" >&2
exit 127
