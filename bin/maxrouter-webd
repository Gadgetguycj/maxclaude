#!/usr/bin/env python3
# maxrouter web GUI. Python stdlib only. mxr is the only API to the system;
# if mxr is missing or broken the dashboard renders an empty state, never 500.
import hmac
import html
import json
import os
import re
import shutil
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

TASK_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
LOG_TAIL_BYTES = 262144
BIND_LABEL = ""


def config_root():
    override = os.environ.get("MAXROUTER_CONFIG_HOME")
    if override:
        return override
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(xdg, "maxclaude")


def find_mxr():
    p = shutil.which("mxr")
    if p:
        return p
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "mxr")
    if os.access(p, os.X_OK):
        return p
    p = os.path.join(os.path.expanduser("~"), ".local", "bin", "mxr")
    return p if os.access(p, os.X_OK) else None


def mxr_run(args, timeout):
    """Returns (rc, stdout, stderr); rc<0 means mxr missing/timed out."""
    mxr = find_mxr()
    if not mxr:
        return (-1, "", "mxr not found")
    try:
        p = subprocess.run([mxr] + args, capture_output=True, text=True, timeout=timeout)
        return (p.returncode, p.stdout, p.stderr)
    except subprocess.TimeoutExpired:
        return (-2, "", "mxr timed out after %ss" % timeout)
    except OSError as e:
        return (-1, "", str(e))


def mxr_json(args, timeout=20):
    rc, out, _err = mxr_run(args, timeout)
    if rc != 0:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def log_tail(n=30):
    path = os.path.join(config_root(), "master-log.jsonl")
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - LOG_TAIL_BYTES))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    out = []
    for ln in lines[-n:]:
        try:
            e = json.loads(ln)
        except ValueError:
            continue
        if isinstance(e, dict):
            out.append(e)
    out.reverse()
    return out


def get_state():
    st = {
        "bind": BIND_LABEL,
        "config_root": config_root(),
        "mxr": "unavailable",
        "orgs": [],
        "tasks": [],
        "status": None,
        "log": log_tail(30),
    }
    ok = False
    orgs = mxr_json(["orgs", "--json"])
    if orgs is not None:
        ok = True
        if isinstance(orgs, dict):
            orgs = orgs.get("orgs", [])
        if isinstance(orgs, list):
            st["orgs"] = [o for o in orgs if isinstance(o, dict)]
    tasks = mxr_json(["tasks", "--json"])
    if tasks is not None:
        ok = True
        if isinstance(tasks, dict):
            tasks = tasks.get("tasks", tasks)
        if isinstance(tasks, dict):
            tasks = [dict(v, name=k) for k, v in tasks.items() if isinstance(v, dict)]
        if isinstance(tasks, list):
            st["tasks"] = [t for t in tasks if isinstance(t, dict) and t.get("name")]
    status = mxr_json(["status", "--json"])
    if status is not None:
        ok = True
        st["status"] = status
    if ok:
        st["mxr"] = "ok"
    return st


